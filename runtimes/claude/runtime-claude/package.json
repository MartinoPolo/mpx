{
  "name": "@mpx/runtime-claude",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "pnpm --filter @mpx/runtime-claude... build && vitest run",
    "test": "pnpm run test:unit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "@mpx/dev-services": "workspace:*",
    "@mpx/runtime-contracts": "workspace:*",
    "@mpx/runtime-hooks": "workspace:*",
    "@mpx/runtime-tools": "workspace:*",
    "@mpx/skills": "workspace:*",
    "@mpx/status": "workspace:*",
    "@mpx/subagents": "workspace:*"
  },
  "devDependencies": {
    "@mpx/config": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
