    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-agents.mjs"
  },
  "dependencies": {
    "@mpx/runtime-contracts": "workspace:*",
    "@mpx/runtime-hooks": "workspace:*",
    "@mpx/skills": "workspace:*",
    "@mpx/status": "workspace:*"
  },
  "devDependencies": { "@mpx/windows": "workspace:*", "@types/node": "^22.15.0", "typescript": "^5.8.3", "vitest": "^3.2.4" }
}
