diff --git a/src/session-record.ts b/src/session-record.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07952a5568e86e64f73c4df91ccca1f362d3e252
--- /dev/null
+++ b/src/session-record.ts
@@ -0,0 +1,24 @@
+import { closeSync, openSync, readSync, realpathSync } from "node:fs";
+import type { AgentRecord } from "./types.js";
+
+export function savedRecord(record: AgentRecord) {
+  const { session, promise, startGate, abortController, outputCleanup, pendingSteers, ...data } = record;
+  return { ...data, schema: 1 };
+}
+
+export function validateChildReference(record: Pick<AgentRecord, "sessionFile">, parentFile: string | undefined): string {
+  if (!record.sessionFile || !parentFile) throw new Error("Saved child context is unavailable");
+  const descriptor = openSync(record.sessionFile, "r");
+  let firstLine: string;
+  try {
+    const buffer = Buffer.alloc(65536);
+    const length = readSync(descriptor, buffer, 0, buffer.length, 0);
+    firstLine = buffer.subarray(0, length).toString("utf8").split(/\r?\n/, 1)[0];
+  } finally { closeSync(descriptor); }
+  const header = JSON.parse(firstLine);
+  if (header.type !== "session" || typeof header.parentSession !== "string" ||
+      realpathSync(header.parentSession) !== realpathSync(parentFile)) {
+    throw new Error("Saved child parentSession does not match the current parent");
+  }
+  return record.sessionFile;
+}
