+      if (!this.owns(record)) continue;
+      this.writeRecord({ ...savedRecord(record),
+        status: this.manager.isSettled(record.id) ? record.status : "stopped" });
+    }
+    this.generation++;
+    this.context = undefined;
+  }
+  reserveRpc(record: AgentRecord): boolean {
+    const receipts = this.reserve([record]);
+    if (!receipts.length) return false;
+    this.rpcClaims.set(key(record), { ...record });
+    return true;
+  }
+  toolDetails(content: readonly { type: string; text?: string }[], details: unknown): unknown {
+    const text = content.flatMap(block => block.type === "text" ? [block.text ?? ""] : []).join("\n");
+    const receipts = resultReceipts(details);
+    for (const [identity, record] of this.rpcClaims) {
+      const output = record.result || record.error;
+      const identifiesRecord = text.includes(record.id) || object(details) && (details.agentId === record.id || details.id === record.id);
+      if (!output || !identifiesRecord || !text.includes(output)) continue;
+      const receipt = this.claims.get(identity);
+      if (receipt) receipts.push(receipt);
+      this.rpcClaims.delete(identity);
+    }
+    return receipts.length ? { ...(object(details) ? details : {}), subagentReceipts: receipts } : details;
+  }
+  track(record: AgentRecord): void {
+    if (!this.context || record.parentSessionId !== this.context.sessionManager.getSessionId()) return;
+    if (!this.origins.has(record)) this.origins.set(record, this.generation);
+    this.persist(record);
+  }
+  owns(record: AgentRecord): boolean {
+    return !!this.context && isTopLevelAgent(record) && this.origins.get(record) === this.generation &&
+      record.parentSessionId === this.context.sessionManager.getSessionId();
+  }
+  private writeRecord(data: ReturnType<typeof savedRecord>): void {
+    try { this.pi.appendEntry("subagents:record", data); }
+    catch (error) { console.warn("[pi-subagents] Outcome persistence failed:", String(error).slice(0, 240)); }
+  }
+  persist(record: AgentRecord): void {
+    if (this.owns(record)) this.writeRecord(savedRecord(record));
+  }
+  completed(record: AgentRecord): void {
+    if (!this.owns(record)) return;
+    this.persist(record);
+    this.recover();
+  }
+  reserve(records: readonly AgentRecord[]): ResultReceipt[] {
+    const receipts: ResultReceipt[] = [];
+    for (const record of records) {
+      const live = this.manager.getRecord(record.id);
+      if (!live || !this.owns(live) || live.runRevision !== record.runRevision || !this.manager.isSettled(record.id)) continue;
+      const existing = this.claims.get(key(record));
+      if (existing) { receipts.push(existing); continue; }
+      const receipt = { id: record.id, runRevision: record.runRevision, transaction: randomUUID() };
+      this.claims.set(key(record), receipt);
+      receipts.push(receipt);
+    }
+    return receipts;
+  }
+  reconcile(release = true): void {
+    if (!this.context) return;
+    const accepted = new Set<string>();
+    for (const entry of this.context.sessionManager.getBranch()) {
+      const details = entry.type === "custom_message" ? entry.details :
+        entry.type === "message" && entry.message.role === "toolResult" ? entry.message.details : undefined;
+      for (const receipt of resultReceipts(details)) {
+        accepted.add(key(receipt));
+        const record = this.manager.getRecord(receipt.id);
+        if (!record || record.runRevision !== receipt.runRevision || record.resultConsumed) continue;
+        record.resultConsumed = true;
+        this.claims.delete(key(receipt));
+        this.pi.events.emit("subagents:result-delivered", { id: receipt.id, runRevision: receipt.runRevision });
+      }
+    }
+    if (release) {
+      for (const identity of this.claims.keys()) if (!accepted.has(identity)) this.claims.delete(identity);
+      for (const record of this.manager.listAgents()) if (this.manager.isSettled(record.id)) record.blocking = false;
+    }
+  }
+  recover(): void {
+    const context = this.context;
+    if (!context || !this.armed || !context.isIdle()) return;
+    const records = this.manager.listAgents().filter(record => this.owns(record) &&
+      this.manager.isSettled(record.id) && !record.resultConsumed && !record.blocking &&
+      !this.claims.has(key(record)) && !this.attempted.has(key(record))).slice(0, 3);
+    if (!records.length) return;
+    const receipts = this.reserve(records);
+    for (const record of records) this.attempted.add(key(record));
+    const content = records.map(record => {
+      const output = (record.error ? `Error: ${record.error}\n` : "") + (record.result || "No output.");
+      return `Agent ${record.id} (${record.status}), run ${record.runRevision}\n${output.slice(0, 15000)}` +
+        (output.length > 15000 ? "\n[Truncated; use get_subagent_result for inspection.]" : "");
+    }).join("\n\n---\n\n");
+    try {
+      this.pi.sendMessage({ customType: "subagents:results", content, display: false,
+        details: { subagentReceipts: receipts } }, { triggerTurn: true });
+    } catch (error) {
+      for (const receipt of receipts) this.claims.delete(key(receipt));
+      console.warn("[pi-subagents] Result delivery failed:", String(error).slice(0, 240));
+    }
+  }
+}
