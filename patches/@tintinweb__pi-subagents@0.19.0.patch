+  if (!object(details) || !Array.isArray(details.subagentReceipts)) return [];
+  return details.subagentReceipts.filter((item: unknown): item is ResultReceipt => object(item) &&
+    typeof item.id === "string" && Number.isInteger(item.runRevision) && typeof item.transaction === "string");
