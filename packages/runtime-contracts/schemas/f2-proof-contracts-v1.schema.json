{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.local/schemas/f2-proof-contracts-v1.schema.json",
  "title": "MPX Phase F2 proof contracts v1",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "SbxPinV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "version", "buildCommit", "releaseCommit", "contribReviewCommit", "windowsBinarySha256", "reviewedArtifactSha256", "rejectedIntegrations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "product": { "const": "docker-sbx-standalone" }, "version": { "const": "0.39.0" },
        "buildCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "releaseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "contribReviewCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "windowsBinarySha256": { "$ref": "#/$defs/sha256" },
        "reviewedArtifactSha256": { "type": "object", "additionalProperties": false, "required": ["license", "features", "commands"], "properties": { "license": { "$ref": "#/$defs/sha256" }, "features": { "$ref": "#/$defs/sha256" }, "commands": { "$ref": "#/$defs/sha256" } } },
        "rejectedIntegrations": { "const": ["contrib-pi-kit", "legacy-docker-sandbox"] }
      }
    },
    "SbxDiagnosticsV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sbxPinSha256", "status", "checks"], "properties": { "schemaVersion": { "const": 1 }, "sbxPinSha256": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["pass", "fail"] }, "checks": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["code", "status", "evidenceSha256"], "properties": { "code": { "$ref": "#/$defs/boundedText" }, "status": { "enum": ["pass", "fail"] }, "evidenceSha256": { "$ref": "#/$defs/sha256" } } } } } },
    "SandboxPlanV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "planKey", "runtime", "sbxPinSha256", "runtimeToolInventorySha256", "executorEvidenceSha256", "networkPolicy", "workspaceReference"], "properties": { "schemaVersion": { "const": 1 }, "planKey": { "$ref": "#/$defs/sha256" }, "runtime": { "enum": ["claude", "pi"] }, "sbxPinSha256": { "$ref": "#/$defs/sha256" }, "runtimeToolInventorySha256": { "$ref": "#/$defs/sha256" }, "executorEvidenceSha256": { "$ref": "#/$defs/sha256" }, "networkPolicy": { "const": "deny-by-default" }, "workspaceReference": { "$ref": "#/$defs/boundedText" } } },
    "SandboxAttestationV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "planKey", "sbxPinSha256", "runtimeToolInventorySha256", "executorEvidenceSha256", "diagnosticsSha256", "outcome"], "properties": { "schemaVersion": { "const": 1 }, "planKey": { "$ref": "#/$defs/sha256" }, "sbxPinSha256": { "$ref": "#/$defs/sha256" }, "runtimeToolInventorySha256": { "$ref": "#/$defs/sha256" }, "executorEvidenceSha256": { "$ref": "#/$defs/sha256" }, "diagnosticsSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["pass", "fail"] } } },
    "RemoteToolRequestV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "toolPath", "inputSha256"], "properties": { "schemaVersion": { "const": 1 }, "requestId": { "$ref": "#/$defs/boundedText" }, "toolPath": { "$ref": "#/$defs/boundedText" }, "inputSha256": { "$ref": "#/$defs/sha256" } } },
    "RemoteToolResultV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "status", "outputSha256", "errorCode"], "properties": { "schemaVersion": { "const": 1 }, "requestId": { "$ref": "#/$defs/boundedText" }, "status": { "enum": ["ok", "error"] }, "outputSha256": { "$ref": "#/$defs/sha256" }, "errorCode": { "oneOf": [{ "$ref": "#/$defs/boundedText" }, { "type": "null" }] } } },
    "SandboxResumeTokenV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "tokenKey", "planKey", "attestationSha256", "expiresAtEpochMs"], "properties": { "schemaVersion": { "const": 1 }, "tokenKey": { "$ref": "#/$defs/sha256" }, "planKey": { "$ref": "#/$defs/sha256" }, "attestationSha256": { "$ref": "#/$defs/sha256" }, "expiresAtEpochMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
    "F2ProofReportV1": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "reportKey", "planKey", "sbxPinSha256", "runtimeToolInventorySha256", "executorEvidenceSha256", "attestationSha256", "verdict"], "properties": { "schemaVersion": { "const": 1 }, "reportKey": { "$ref": "#/$defs/sha256" }, "planKey": { "$ref": "#/$defs/sha256" }, "sbxPinSha256": { "$ref": "#/$defs/sha256" }, "runtimeToolInventorySha256": { "$ref": "#/$defs/sha256" }, "executorEvidenceSha256": { "$ref": "#/$defs/sha256" }, "attestationSha256": { "$ref": "#/$defs/sha256" }, "verdict": { "enum": ["pass", "fail"] } } }
  }
}
