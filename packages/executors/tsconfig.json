{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "test/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/fixtures/**",
    "src/**/__fixtures__/**",
    "src/**/fixture/**",
    "src/**/test-fixtures/**"
  ]
}
