  "service":{"type":"object","additionalProperties":false,"required":["scope","port","start"],"properties":{"scope":{"enum":["checkout","project"]},"port":{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["managed","fixed-shared"]},"preferred":{"type":"integer","minimum":1,"maximum":65535},"family":{"type":"string","minLength":1}}},"environmentVariable":{"type":"string","pattern":"^[A-Z_][A-Z0-9_]*$"},"protocol":{"enum":["http","https","tcp"]},"start":{"type":"object","additionalProperties":false,"required":["type","script"],"properties":{"type":{"const":"package-script"},"script":{"type":"string","minLength":1}}}}}
 }
}
