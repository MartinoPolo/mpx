{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.dev/schemas/user-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identities",
    "domains",
    "locations",
    "modes",
    "presets",
    "launchDefaults",
    "networkPolicies",
    "executors"
  ],
  "properties": {
    "identities": {
      "$ref": "#/$defs/identityMap"
    },
    "domains": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/roots"
      }
    },
    "modes": {
      "type": "object",
      "propertyNames": {
        "enum": ["project", "developer", "computer-control", "unrestricted"]
      },
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/preset"
      }
    },
    "launchDefaults": {
      "$ref": "#/$defs/launchDefaults"
    },
    "networkPolicies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/networkPolicy"
      }
    },
    "executors": {
      "type": "object",
      "propertyNames": {
        "enum": ["host", "docker"]
      },
      "additionalProperties": {
        "$ref": "#/$defs/empty"
      }
    },
    "projects": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/projectId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/override"
      }
    },
    "localIssueStores": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localIssueStore"
      }
    },
    "localViews": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localView"
      }
    },
    "schemaVersion": {
      "const": 2
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "resourceRoots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/roots"
      },
      "propertyNames": {
        "enum": [
          "cloned-repositories",
          "computer-control-config",
          "computer-control-executable-settings"
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$",
      "maxLength": 129
    },
    "route": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false
    },
    "localIssueStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "localView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vaultRoot", "outputRoot", "vaultSubtree", "resumeBaseUrl"],
      "properties": {
        "vaultRoot": {
          "$ref": "#/$defs/path"
        },
        "outputRoot": {
          "$ref": "#/$defs/path"
        },
        "vaultSubtree": {
          "type": "string",
          "pattern": "^MPX(?:/[A-Za-z0-9._-]+)+$"
        },
        "resumeBaseUrl": {
          "type": "string",
          "pattern": "^mpx://[A-Za-z0-9/?&=._%-]+$"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources"],
      "properties": {
        "resources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "selected-project",
              "identity-domain",
              "cloned-repositories",
              "computer-control-config",
              "computer-control-executable-settings",
              "host"
            ]
          },
          "additionalProperties": {
            "enum": ["read-only", "read-write", "staged-write"]
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillPacks": {
          "$ref": "#/$defs/skillPacks"
        }
      },
      "required": ["skillPacks"]
    },
    "identityMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identity"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "runtimeRoots", "gitAuthorRoute", "allowedSkillPacks"],
      "properties": {
        "domain": {
          "$ref": "#/$defs/id"
        },
        "runtimeRoots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "pi"],
          "properties": {
            "claude": {
              "$ref": "#/$defs/path"
            },
            "pi": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "gitAuthorRoute": {
          "$ref": "#/$defs/route"
        },
        "providerRoutes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        },
        "sshRoute": {
          "$ref": "#/$defs/route"
        },
        "mcpSharing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "shareNativeAuth"],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/route"
              }
            },
            "shareNativeAuth": {
              "const": false
            }
          }
        },
        "allowedSkillPacks": {
          "$ref": "#/$defs/skillPacks"
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "mode", "executor", "workspace", "networkPolicy"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "$ref": "#/$defs/id"
        },
        "executor": {
          "enum": ["host", "docker"]
        },
        "workspace": {
          "enum": ["clone", "host-worktree", "direct"]
        },
        "networkPolicy": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "identityPresetDefaults": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "launchDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "projects"],
      "properties": {
        "projects": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/projectId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identityPresetDefaults"
          }
        },
        "locations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identityPresetDefaults"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "preset": {
          "enum": ["allow-all", "balanced", "deny-all"]
        },
        "extends": {
          "$ref": "#/$defs/id"
        },
        "denyPrivateNetworks": {
          "type": "boolean"
        },
        "approvedProjectAdditions": {
          "type": "boolean"
        },
        "approvedDeliveryAdditions": {
          "type": "boolean"
        },
        "requiredRuntimeEndpoints": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "preset": {},
            "extends": {}
          },
          "required": ["preset"],
          "not": {
            "properties": {
              "extends": {}
            },
            "required": ["extends"]
          }
        },
        {
          "properties": {
            "preset": {},
            "extends": {}
          },
          "required": ["extends"],
          "not": {
            "properties": {
              "preset": {}
            },
            "required": ["preset"]
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "skillPacks"],
      "properties": {
        "roots": {
          "$ref": "#/$defs/roots"
        },
        "skillPacks": {
          "$ref": "#/$defs/skillPacks"
        }
      }
    },
    "skillPacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["development", "personal"]
      }
    }
  }
}
