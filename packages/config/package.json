{
  "name": "@mpx/config",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "pnpm --filter @mpx/config... build && vitest run",
    "test": "pnpm run test:unit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "@mpx/core": "workspace:*",
    "ajv": "^8.17.1"
  }
}
