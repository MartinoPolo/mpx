{
  "schemaVersion": 2,
  "identities": {
    "personal": {
      "domain": "personal",
      "runtimeRoots": { "claude": "~/.claude", "pi": "~/.pi/agent" },
      "gitAuthorRoute": "personal",
      "providerRoutes": { "github": "github-personal" },
      "sshRoute": "personal-agent",
      "mcpSharing": { "allow": ["context7"], "shareNativeAuth": false },
      "allowedSkillPacks": ["development", "personal"]
    },
    "work": {
      "domain": "work",
      "runtimeRoots": { "claude": "~/.claude-work", "pi": "~/.pi/agent-work" },
      "gitAuthorRoute": "work",
      "providerRoutes": { "gitlab": "gitlab-work", "kanbanflow": "kanbanflow-work" },
      "sshRoute": "work-agent",
      "mcpSharing": { "allow": ["context7"], "shareNativeAuth": false },
      "allowedSkillPacks": ["development"]
    }
  },
  "domains": {
    "personal": [
      "${MPX_PROJECTS}",
      "${MPX_CLONED}",
      "${MPX_OBSIDIAN_VAULT}",
      "${MPX_AI_GENERATED}"
    ],
    "work": ["${MPX_WORK}"]
  },
  "locations": {
    "personal-coding": {
      "roots": ["${MPX_PROJECTS}", "${MPX_CLONED}"],
      "skillPacks": ["development"]
    },
    "work-coding": { "roots": ["${MPX_WORK}"], "skillPacks": ["development"] },
    "notes": { "roots": ["${MPX_OBSIDIAN_VAULT}"], "skillPacks": ["personal"] },
    "assets": { "roots": ["${MPX_AI_GENERATED}"], "skillPacks": ["personal"] }
  },
  "resourceRoots": { "cloned-repositories": ["${MPX_CLONED}"] },
  "modes": {
    "project": { "resources": { "selected-project": "read-write" } },
    "developer": {
      "resources": { "identity-domain": "read-write", "cloned-repositories": "read-only" }
    },
    "computer-control": {
      "resources": {
        "computer-control-config": "read-write",
        "computer-control-executable-settings": "staged-write"
      }
    },
    "unrestricted": { "resources": { "host": "read-write" } }
  },
  "presets": {
    "personal-dev": {
      "identity": "personal",
      "mode": "developer",
      "executor": "docker",
      "workspace": "clone",
      "networkPolicy": "implementation"
    },
    "work-project": {
      "identity": "work",
      "mode": "project",
      "executor": "docker",
      "workspace": "clone",
      "networkPolicy": "implementation"
    }
  },
  "launchDefaults": {
    "locations": {
      "personal-coding": { "personal": "personal-dev" },
      "work-coding": { "work": "work-project" }
    },
    "projects": { "MartinoPolo/mpx": { "personal": "personal-dev", "work": "work-project" } }
  },
  "networkPolicies": {
    "implementation": { "preset": "balanced", "approvedProjectAdditions": true }
  },
  "executors": { "host": {}, "docker": {} }
}
