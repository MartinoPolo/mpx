{
  "schemaVersion": 1,
  "project": { "id": "service-manifests/shared" },
  "repository": { "provider": "generic", "remote": "origin" },
  "development": {
    "services": {
      "storybook": {
        "scope": "project",
        "port": { "mode": "fixed-shared", "preferred": 6006 },
        "environmentVariable": "STORYBOOK_URL",
        "protocol": "http",
        "start": { "type": "package-script", "script": "storybook" }
      }
    }
  }
}
