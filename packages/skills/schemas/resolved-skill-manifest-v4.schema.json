{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.local/schemas/resolved-skill-manifest-v4.schema.json",
  "title": "ResolvedSkillManifestV4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestKey", "binding", "decisions"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "manifestKey": { "type": "string", "minLength": 1 },
    "binding": { "$ref": "#/$defs/binding" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "included", "exclusionReasons", "exposure", "permissions", "metadataHash", "sourceHash"],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "included": { "type": "boolean" },
          "exclusionReasons": { "type": "array", "items": { "type": "string" } },
          "exposure": { "enum": ["full", "name-only", "explicit-only", "off"] },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["humanInvocation", "modelInvocation"],
            "properties": {
              "humanInvocation": { "type": "boolean" },
              "modelInvocation": { "type": "boolean" }
            }
          },
          "metadataHash": { "type": "string", "minLength": 1 },
          "sourceHash": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "repositoryId", "contentScope"],
      "properties": {
        "projectId": { "type": ["string", "null"] },
        "repositoryId": { "type": "string", "minLength": 1 },
        "contentScope": { "type": "string", "minLength": 1 }
      }
    }
  }
}
