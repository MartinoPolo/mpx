{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.local/schemas/resolved-skill-manifest-v5.schema.json",
  "title": "ResolvedSkillManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestKey", "binding", "decisions"],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "manifestKey": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "included",
          "exclusionReasons",
          "exposure",
          "permissions",
          "metadataHash",
          "sourceHash"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "included": {
            "type": "boolean"
          },
          "exclusionReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exposure": {
            "enum": ["full", "name-only", "explicit-only"]
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["humanInvocation", "modelInvocation"],
            "properties": {
              "humanInvocation": {
                "type": "boolean"
              },
              "modelInvocation": {
                "type": "boolean"
              }
            }
          },
          "metadataHash": {
            "type": "string",
            "minLength": 1
          },
          "sourceHash": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "repositoryId", "identity", "selection"],
      "properties": {
        "projectId": {
          "type": ["string", "null"]
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location", "packs", "source"],
          "properties": {
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "canonicalRoot"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "canonicalRoot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?:/|\\\\|[A-Za-z]:[\\\\/])"
                }
              }
            },
            "packs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["development", "personal"]
              }
            },
            "source": {
              "enum": ["project", "user-project", "user-location"]
            }
          }
        }
      }
    }
  }
}
