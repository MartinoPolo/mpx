{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.local/schemas/runtime-context-v1.schema.json",
  "title": "RuntimeContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "launchKey",
    "launchDescriptor",
    "manifestKey",
    "runtimeArtifact",
    "binding"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "launchKey": { "type": "string", "minLength": 1 },
    "launchDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\]).+"
        },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "manifestKey": { "type": "string", "minLength": 1 },
    "runtimeArtifact": { "$ref": "runtime-skill-artifact-reference-v4.schema.json" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "repositoryId", "contentScope"],
      "properties": {
        "projectId": { "type": ["string", "null"] },
        "repositoryId": { "type": "string", "minLength": 1 },
        "contentScope": { "type": "string", "minLength": 1 }
      }
    }
  }
}
