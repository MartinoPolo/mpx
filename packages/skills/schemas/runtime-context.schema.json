{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpx.local/schemas/runtime-context-v2.schema.json",
  "title": "RuntimeContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "launchKey",
    "launchDescriptor",
    "manifestKey",
    "runtimeArtifact",
    "binding"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "launchKey": {
      "type": "string",
      "minLength": 1
    },
    "launchDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![/\\\\]).+"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifestKey": {
      "type": "string",
      "minLength": 1
    },
    "runtimeArtifact": {
      "$ref": "runtime-skill-artifact-reference-v5.schema.json"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "repositoryId", "identity", "selection"],
      "properties": {
        "projectId": {
          "type": ["string", "null"]
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location", "packs", "source"],
          "properties": {
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "canonicalRoot"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "canonicalRoot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?:/|\\\\|[A-Za-z]:[\\\\/])"
                }
              }
            },
            "packs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["development", "personal"]
              }
            },
            "source": {
              "enum": ["project", "user-project", "user-location"]
            }
          }
        }
      }
    }
  }
}
