      "destinationSha256": "b2fc721308e1c3244f019687d6ff63497d3eb55f7139ef1ce98f64f778deded6",
      "flow": [
        {
          "dimension": "trigger",
          "clause": "When `the invocation input` carries a path to a `.rayconfig`, use it"
        },
        {
          "dimension": "branch",
          "clause": "Otherwise **ask the user where the export is**"
        },
        {
          "dimension": "privacy",
          "clause": "The payload contains clipboard history in clear text, so it stays out of synced and version-controlled folders"
        },
        {
          "dimension": "gate",
          "clause": "invalid-id`, `duplicate-id` and `unpaired-openwith` are **not** advisory"
        },
        {
          "dimension": "output-containment",
          "clause": "Write the rebuilt file to a per-run folder under `MPX_AI_GENERATED/_RAYCAST/`"
        },
        {
          "dimension": "gate",
          "clause": "wait for explicit confirmation before importing"
        },
        {
          "dimension": "fallback",
          "clause": "the original export next to it is the way back"
        },
        {
          "dimension": "outcome",
          "clause": "Close with what changed, as a table"
        }
      ],
