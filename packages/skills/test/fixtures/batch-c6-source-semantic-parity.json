      "flow": [
        {
          "dimension": "trigger",
          "clause": "This registers a project that already exists on disk"
        },
        {
          "dimension": "gate",
          "clause": "Stop here and ask before touching anything"
        },
        {
          "dimension": "os-containment",
          "clause": "Resolve the home directory from the environment rather than writing it out"
        },
        {
          "dimension": "branch",
          "clause": "Offer a **Skip Raycast** option too"
        },
        {
          "dimension": "asset",
          "clause": "read [REPOSITORY_INIT.md](REPOSITORY_INIT.md) and follow that branch"
        },
        {
          "dimension": "manual-handoff",
          "clause": "carry out its process yourself, in this conversation, with the export path from step 1"
        },
        {
          "dimension": "privacy",
          "clause": "Do not infer or reconstruct the vault root from a home or sync-directory path"
        },
        {
          "dimension": "outcome",
          "clause": "Close with a table of surfaces touched"
        }
      ],
