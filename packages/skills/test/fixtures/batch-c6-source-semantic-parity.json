          "clause": "Fresh notes live under the single `# To Process` intake lane"
        },
        {
          "dimension": "branch",
          "clause": "skip any that already carry a `→ #<N>` annotation"
        },
        {
          "dimension": "privacy",
          "clause": "read each image at `.mpx/board-files/<filename>`"
        },
        {
          "dimension": "gate",
          "clause": "Only create issues after the user confirms the plan"
        },
        {
          "dimension": "outcome",
          "clause": "move its item from `# To Process` to `# Ready to implement`"
        },
        {
          "dimension": "fallback",
          "clause": "if Edit/Write refuses it, resolve to the real vault path and edit that"
        },
        {
