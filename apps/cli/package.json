{
  "name": "mpx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mpx": "./dist/main.js"
  },
  "scripts": {
    "prebuild": "node ../../scripts/prepare-cli-build.mjs",
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-cli.mjs",
    "check": "pnpm run build && tsc -p tsconfig.json --noEmit && vitest run",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mpx/core": "workspace:*",
    "@mpx/dev-services": "workspace:*",
    "@mpx/config": "workspace:*",
    "@mpx/executors": "workspace:*",
    "@mpx/launch": "workspace:*",
    "@mpx/sessions": "workspace:*",
    "@mpx/installer": "workspace:*",
    "@mpx/runtime-claude": "workspace:*",
    "@mpx/runtime-contracts": "workspace:*",
    "@mpx/runtime-pi": "workspace:*",
    "@mpx/runtime-tools": "workspace:*",
    "@mpx/provider-github": "workspace:*",
    "@mpx/provider-gitlab": "workspace:*",
    "@mpx/provider-kanbanflow": "workspace:*",
    "@mpx/provider-local": "workspace:*",
    "@mpx/providers": "workspace:*",
    "@mpx/skills": "workspace:*",
    "@mpx/ports": "workspace:*",
    "@mpx/windows": "workspace:*",
    "@mpx/status": "workspace:*",
    "@mpx/worktrees": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
