{
  "name": "mpx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mpx": "./dist/main.js"
  },
  "scripts": {
    "prebuild": "node ../../scripts/prepare-cli-build.mjs",
    "build": "tsc -p tsconfig.json",
    "test:unit": "pnpm --filter mpx... build && vitest run",
    "test": "pnpm run test:unit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check": "pnpm run build && pnpm run typecheck"
  },
  "dependencies": {
    "@mpx/application": "workspace:*",
    "@mpx/config": "workspace:*",
    "@mpx/content-compiler": "workspace:*",
    "@mpx/core": "workspace:*",
    "@mpx/executors": "workspace:*",
    "@mpx/installer": "workspace:*",
    "@mpx/launch": "workspace:*",
    "@mpx/ports": "workspace:*",
    "@mpx/providers": "workspace:*",
    "@mpx/runtime-contracts": "workspace:*",
    "@mpx/sessions": "workspace:*",
    "@mpx/skills": "workspace:*",
    "@mpx/status": "workspace:*",
    "@mpx/windows": "workspace:*",
    "@mpx/worktrees": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
