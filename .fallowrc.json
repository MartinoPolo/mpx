{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/**/*.{js,mjs,ts}",
    "content/skills/*/scripts/*.{js,mjs}",
    "apps/cli/src/main.ts",
    "tests/contract/**/*.{test,spec}.ts",
    "tests/integration/**/*.{test,spec}.{js,mjs,ts}",
    "packages/installer/test/fixtures/projection-retention-process.mjs",
    "packages/worktrees/test/fixtures/activating-inert-worker.mjs",
    "packages/worktrees/test/fixtures/delayed-inert-worker.mjs",
    "packages/worktrees/test/fixtures/preparation-cas-worker.mjs",
    "tests/integration/windows/fixtures/owned-process-tree.mjs",
    "tests/integration/worktrees/fixtures/preparation-persisted-worker.mjs",
    "runtimes/pi/extensions/guards/dangerous-command-guard.mjs",
    "runtimes/pi/extensions/guards/enforce-pkg-mgr.mjs",
    "runtimes/pi/extensions/guards/fallow-gate.mjs",
    "runtimes/pi/extensions/guards/format-lint-file.mjs",
    "runtimes/pi/extensions/guards/machine-paths.mjs",
    "runtimes/pi/extensions/guards/post-bash-context.mjs",
    "runtimes/pi/extensions/guards/pre-commit-gate.mjs",
    "runtimes/pi/extensions/test/pi-package-entry.mjs",
    "runtimes/pi/extensions/test/unit/guards/child-process-argv.test.mjs",
    "runtimes/pi/extensions/test/unit/guards/windows-null-redirection.test.mjs"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "artifacts/**",
    "bin/claude-gateway.js",
    "bin/mpx.mjs",
    "runtimes/pi/runtime-pi/vendor/**"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": ["@mermaid-js/mermaid-cli", "shiki", "yaml"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["**/*.test.ts", "**/*.spec.ts"]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "warn",
    "test-only-dependencies": "warn",
    "dev-dependencies-in-production": "error",
    "stale-suppressions": "error"
  }
}
