{
  "name": "mpx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm run build && pnpm run test:integration && pnpm -r test",
    "test:integration": "vitest run scripts/validate-generated.test.mjs",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "baseline:capture": "node scripts/capture-migration-baseline.mjs",
    "validate:generated": "node scripts/validate-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
