{
  "name": "mpx-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm run check:quality && pnpm run validate:generated && pnpm run validate:structure && pnpm -r check",
    "check:quality": "pnpm run format:check && pnpm run lint && pnpm run check:fallow",
    "check:fallow": "fallow --regression-baseline fallow-baselines/regression.json --fail-on-regression --format json --quiet --output-file .fallow/check.json",
    "fallow:audit": "fallow audit --base main --gate new-only",
    "fallow:baseline": "fallow --save-regression-baseline fallow-baselines/regression.json --format json --quiet --output-file .fallow/baseline.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --report-unused-disable-directives && prettier --write .",
    "test": "pnpm run test:unit && pnpm run test:payload && pnpm run test:contract && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "pnpm run build && vitest run --config vitest.unit.config.ts",
    "test:payload": "vitest run --config vitest.payload.config.ts",
    "test:contract": "pnpm --filter @mpx/provider-github... --filter @mpx/runtime-contracts... build && vitest run --config vitest.contract.config.ts",
    "test:integration": "pnpm --filter mpx... build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter mpx... build && vitest run --config vitest.e2e.config.ts",
    "test:convergence": "node scripts/required-convergence.mjs",
    "typecheck": "pnpm -r build && tsc -p tsconfig.test.json && pnpm -r typecheck",
    "convergence:generate": "node scripts/generate-convergence-manifest.mjs",
    "convergence:verify": "node scripts/generate-convergence-manifest.mjs --check",
    "bundle:cli": "pnpm --filter @mpx/pi-extensions run build:release && pnpm --filter @mpx/pi-extensions run verify:release && node scripts/bundle-cli.mjs",
    "bundle:generate": "pnpm run bundle:cli",
    "cli-docs:generate": "node scripts/generate-cli-docs.mjs",
    "cli-docs:check": "node scripts/generate-cli-docs.mjs --check",
    "validate:generated": "node scripts/validate-generated.mjs",
    "validate:structure": "node scripts/validate-structure.mjs"
  },
  "devDependencies": {
    "@mpx/application": "workspace:*",
    "@mpx/config": "workspace:*",
    "@mpx/core": "workspace:*",
    "@mpx/executors": "workspace:*",
    "@mpx/installer": "workspace:*",
    "@mpx/provider-github": "workspace:*",
    "@mpx/providers": "workspace:*",
    "@mpx/runtime-contracts": "workspace:*",
    "@mpx/runtime-pi": "workspace:*",
    "@mpx/sessions": "workspace:*",
    "@mpx/windows": "workspace:*",
    "@mpx/worktrees": "workspace:*",
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "fallow": "^3.20.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
